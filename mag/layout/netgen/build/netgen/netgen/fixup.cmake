include(/home/lenny/projects/test/layout/netgen/src/external_dependencies/netgen/cmake/netgen_fixup.cmake)
set(APP /opt/netgen)
message(${APP})
set(BU_CHMOD_BUNDLE_ITEMS ON)

file(GLOB libs /opt/netgen/lib/*.dylib /opt/netgen/lib/*.so)
message("${libs}")
netgen_fixup_bundle( ${APP}/Contents/MacOS/netgen "${libs}" /opt/netgen/lib )
execute_process(COMMAND ln -s /Applications /opt/netgen/../Applications)
set (bundle_filename $ENV{NETGEN_BUNDLE_NAME})
if(NOT bundle_filename)
  set(bundle_filename netgen)
endif(NOT bundle_filename)
execute_process(COMMAND hdiutil create -volname Netgen -srcfolder /opt/netgen -ov -format UDZO ${bundle_filename}-.dmg)
